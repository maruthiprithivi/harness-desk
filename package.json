{
  "name": "harness-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node start.mjs",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/check-public.mjs --staged",
    "check:public:source": "node scripts/check-public.mjs --source",
    "check:public:history": "node scripts/check-public.mjs --history",
    "check:local": "node scripts/check-local.mjs",
    "check:release": "node scripts/check-release.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "clean:local": "node scripts/cleanup-local.mjs",
    "prepack": "node scripts/check-release.mjs"
  }
}
